    "settings.historySize.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم إزالة العناصر الأقدم عند بلوغ الحد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els elements més antics s’eliminen quan s’arriba al límit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při dosažení limitu se starší položky odstraní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ældre elementer fjernes, når grænsen nås."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ältere Einträge werden entfernt, wenn das Limit erreicht ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα παλαιότερα στοιχεία αφαιρούνται όταν επιτευχθεί το όριο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Older items are removed when the limit is reached."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos más antiguos se eliminan al alcanzar el límite."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanhemmat kohteet poistetaan, kun raja saavutetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments les plus anciens sont supprimés lorsque la limite est atteinte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריטים ישנים יותר יוסרו כאשר יגיעו למגבלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमा पूरी होने पर पुराने आइटम हटा दिए जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Starije stavke uklanjaju se kad se dosegne ograničenje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A korlát elérésekor a régebbi elemek törlődnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item lama dihapus saat batas tercapai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi più vecchi vengono rimossi al raggiungimento del limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限に達すると、古い項目から削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한도에 도달하면 오래된 항목이 제거됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Item lama dialihkan apabila had dicapai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eldre elementer fjernes når grensen nås."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oudere items worden verwijderd wanneer de limiet is bereikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Starsze elementy są usuwane po osiągnięciu limitu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens mais antigos são removidos quando o limite é atingido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens mais antigos são removidos quando o limite é atingido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementele mai vechi sunt eliminate când se atinge limita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При достижении лимита старые элементы удаляются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri dosiahnutí limitu sa staršie položky odstránia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Äldre objekt tas bort när gränsen nås."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการเก่าจะถูกลบเมื่อถึงขีดจำกัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınıra ulaşıldığında eski öğeler kaldırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після досягнення ліміту старі елементи видаляються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục cũ hơn sẽ bị xóa khi đạt giới hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "达到上限后会删除更早的条目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "達到上限時會移除較舊的項目。"
          }
        }
      }
    },
    "settings.hotkeyFallbackNotice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان الاختصار المحفوظ غير متاح؛ تمت استعادة ⇧⌘V."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La drecera desada no estava disponible; s’ha restaurat ⇧⌘V."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložená zkratka nebyla dostupná; obnovena ⇧⌘V."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gemte genvej var utilgængelig; ⇧⌘V blev gendannet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gespeicherte Tastenkürzel war nicht verfügbar, daher wurde ⇧⌘V wiederhergestellt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αποθηκευμένη συντόμευση δεν ήταν διαθέσιμη· επαναφέρθηκε η ⇧⌘V."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved shortcut was unavailable, so ⇧⌘V was restored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El atajo guardado no estaba disponible; se ha restaurado ⇧⌘V."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettu pikanäppäin ei ollut käytettävissä; ⇧⌘V palautettiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le raccourci enregistré était indisponible ; ⇧⌘V a été rétabli."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקיצור השמור לא היה זמין; ⇧⌘V שוחזר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजा गया शॉर्टकट उपलब्ध नहीं था; ⇧⌘V बहाल किया गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremljeni prečac nije bio dostupan; ⇧⌘V je vraćen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentett gyorsbillentyű nem volt elérhető; a ⇧⌘V visszaállításra került."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan tersimpan tidak tersedia; ⇧⌘V dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scorciatoia salvata non era disponibile; è stata ripristinata ⇧⌘V."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたショートカットを使用できなかったため、⇧⌘V に戻しました。"
